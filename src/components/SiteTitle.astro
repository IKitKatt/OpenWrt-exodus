---
import Logo from './Logo.astro';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
	<Logo />
	<span translate="no">Exodus</span>
</a>

<style>
	.site-title {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		min-width: 0;
		font-size: 0.9375rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--ex-foreground);
		text-decoration: none;
		white-space: nowrap;
	}
</style>
