---
import { LinkButton } from '@astrojs/starlight/components';
import Logo from './Logo.astro';

/* Splash-page hero: the logo tile, the title and the actions, centered like an empty state of the web UI. */
const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};
// root-relative links of the actions are given without the base of the site, like the links of the content
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => (href.startsWith('/') && !href.startsWith(`${base}/`) ? `${base}${href}` : href);
---

<div class="hero">
	<Logo size="lg" />
	<h1 id="_top" data-page-title set:html={title} />
	{tagline && <div class="tagline" set:html={tagline} />}
	{
		actions.length > 0 && (
			<div class="actions">
				{actions.map(({ attrs: { class: className, ...attrs } = {}, icon, link, text, variant }) => (
					<LinkButton href={withBase(link)} {variant} icon={icon?.name} class:list={[className]} {...attrs}>
						{text}
						{icon?.html && <Fragment set:html={icon.html} />}
					</LinkButton>
				))}
			</div>
		)
	}
</div>

<style>
	.hero {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		padding-block: clamp(2rem, calc(1rem + 6vmin), 4.5rem) 1rem;
		text-align: center;
	}

	h1 {
		margin-top: 0.5rem;
		font-size: clamp(2.25rem, calc(1rem + 4vw), 3.25rem);
		line-height: 1.1;
		font-weight: 600;
		letter-spacing: -0.035em;
		color: var(--ex-foreground);
	}

	.tagline {
		max-width: 34rem;
		font-size: var(--sl-text-lg);
		line-height: 1.55;
		color: var(--ex-muted-foreground);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 0.5rem;
	}
</style>
