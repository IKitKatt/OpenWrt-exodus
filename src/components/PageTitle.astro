---
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

type SidebarEntry = StarlightRouteData['sidebar'][number];

/** Label of the sidebar group that holds the current page, shown above the title. */
function currentGroup(entries: SidebarEntry[], parent?: string): string | undefined {
	for (const entry of entries) {
		if (entry.type === 'link' && entry.isCurrent) return parent;
		if (entry.type === 'group') {
			const found = currentGroup(entry.entries, entry.label);
			if (found) return found;
		}
	}
}

const { entry, sidebar } = Astro.locals.starlightRoute;
const group = currentGroup(sidebar);
const { title, description } = entry.data;
---

<div class="page-title">
	{group && <span class="group">{group}</span>}
	<h1 id="_top">{title}</h1>
	{description && <p class="description">{description}</p>}
</div>

<style>
	/* The page header of the web UI: a semibold title with a muted description under it. */
	.page-title {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.375rem;
		padding-block: 0.5rem 0.25rem;
	}

	.group {
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--ex-muted-foreground);
	}

	h1 {
		font-size: var(--sl-text-h1);
		line-height: 1.2;
		font-weight: 600;
		letter-spacing: -0.025em;
		color: var(--ex-foreground);
		/* long Russian words don't fit a phone line at full size */
		hyphens: auto;
		overflow-wrap: break-word;
	}

	.description {
		max-width: 40rem;
		font-size: var(--sl-text-lg);
		line-height: 1.55;
		color: var(--ex-muted-foreground);
	}
</style>
